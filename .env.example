# --- Database ---
# Any Postgres connection string works: Vercel Postgres, Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://user:password@host:5432/flexozy"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Discord OAuth App ---
# Create at https://discord.com/developers/applications
# OAuth2 -> Redirects, add: <your-domain>/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Admin access ---
# Comma-separated list of Discord user IDs that should have admin panel access.
# Right-click your Discord profile -> Copy User ID (enable Developer Mode first).
ADMIN_DISCORD_IDS="123456789012345678"

# --- File uploads (optional, only needed for "file" delivery type) ---
# Enable the Vercel Blob integration on your project to get this token.
BLOB_READ_WRITE_TOKEN=""
