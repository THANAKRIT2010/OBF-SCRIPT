# ===== ค่าพื้นฐาน =====
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://flexozy.xyz

# session (สำคัญมาก!! ต้องเป็นค่าสุ่มยาวอย่างน้อย 32 ตัวอักษร ห้ามใช้ค่า default)
# สร้างได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ===== Discord OAuth =====
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://flexozy.xyz/api/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
ADMIN_DISCORD_IDS=123456789012345678,987654321098765432

# ===== Google OAuth (ทางเลือกเสริม) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://flexozy.xyz/api/auth/google/callback

# ===== อีเมล OTP (สมัครสมาชิก/ลืมรหัสผ่าน) =====
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@flexozy.xyz

# ===== เติมเงิน TrueMoney =====
TRUEMONEY_PHONE=

# ===== Vault raw-link subdomain =====
# ต้องเพิ่มโดเมนนี้เป็นอีก Domain ในโปรเจกต์เดียวกันบน Vercel แล้วชี้ DNS (CNAME) มาที่เดียวกับ flexozy.xyz
API_HOST=api.flexozy.xyz

# ===== การป้องกันหน้าแอดมินขั้นสูง (ไม่บังคับ ไม่ตั้งค่าก็ใช้งานได้ปกติ) =====
# จำกัด IP ที่เข้าหน้าแอดมินได้ (คั่นด้วย comma) ปล่อยว่าง = ไม่จำกัด
ADMIN_ALLOWED_IPS=
# รหัส PIN ชั้นที่สองก่อนเข้าหน้าแอดมิน (นอกเหนือจาก login Discord + เป็นแอดมิน) ปล่อยว่าง = ไม่เปิดใช้
ADMIN_PANEL_PIN=

# ===== Vercel KV (Redis) — ผูกอัตโนมัติเมื่อเปิดใช้ Vercel KV ในโปรเจกต์ ไม่ต้องตั้งเอง =====
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
