# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.flexozy.online

# --- NextAuth (Discord login) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=https://www.flexozy.online
# From https://discord.com/developers/applications -> your app -> OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# --- Admin access ---
# Comma-separated Discord user IDs allowed to view /admin
ADMIN_DISCORD_IDS=

# --- Database (Vercel Postgres) ---
# Auto-filled by Vercel when you add the Postgres integration - no need to set manually on Vercel.
POSTGRES_URL=

# --- Optional: Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_MEASUREMENT_PROTOCOL_API_SECRET=
