# Google Cloud Vision API key (Cloud Vision API must be enabled + billing on)
GOOGLE_VISION_API_KEY=

# These two are added automatically once you connect a Vercel KV database
# to this project (Storage tab -> Create Database -> KV -> Connect).
# You do not need to set them by hand on Vercel; only fill them in here
# if you're running `vercel dev` locally and pulling env with `vercel env pull`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
